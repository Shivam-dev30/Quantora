# ==============================================================================
# MULTI-ASSET MARKET ALERT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to source control!

# --- System Settings ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./market_alerts.db
DISPLAY_TIMEZONE=Asia/Kolkata
CONFIG_FILE_PATH=backend/app/config/default_config.yaml

# --- Angel One SmartAPI (Indian Equities, F&O, Commodities) ---
# Register at https://smartapi.angelbroking.com
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_pin_or_password
ANGEL_TOTP_SECRET=your_totp_secret_here

# --- Delta Exchange (Cryptocurrency) ---
# Register at https://www.delta.exchange
# Note: DELTA_API_SECRET is NOT REQUIRED for market data.
# Delta products, historical candles, and WebSocket feeds are public.
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_REST_URL=https://api.delta.exchange
DELTA_WS_URL=wss://socket.delta.exchange

# --- Telegram Notification ---
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email Notification (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=trader@yourdomain.com
SMTP_USE_TLS=true

# --- WhatsApp Official API ---
# See docs/WHATSAPP_OFFICIAL_API.md for Meta Cloud API or Twilio setup
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud # meta_cloud or twilio
# Meta Cloud API:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=
# Twilio Alternative:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=
